# ─── CampusLink 生产环境配置模板 ─────────────────────────────
# 复制为 .env 后填入真实值（服务器上执行：cp .env.prod.example .env && nano .env）
# 生成强随机值示例：
#   openssl rand -hex 32   # JWT_SECRET / 各 shared secret

# ── 数据库 ──
MYSQL_PASSWORD=change-me-strong-db-password
MYSQL_URL=jdbc:mysql://mysql:3306/campusLink_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true

# ── 认证 ──
JWT_SECRET=change-me-64-hex-chars
JWT_EXPIRATION_MS=86400000
SUPER_ADMIN_EMAIL=admin@your-domain.com
SUPER_ADMIN_PASSWORD=change-me-strong-admin-password

# ── Agent 服务间认证（与后端一致，服务器内互访）──
AGENT_SHARED_SECRET=change-me-64-hex-chars
AGENT_BACKEND_SHARED_SECRET=change-me-64-hex-chars
LOST_FOUND_CONFIRMATION_SECRET=change-me-64-hex-chars

# ── Lost & Found 预训练多模态匹配 ──
# CD 会启用 multimodal profile；共享密钥用于保护内部 Embedding API。
LOST_FOUND_EMBEDDING_MODE=auto
LOST_FOUND_EMBEDDING_SHARED_SECRET=change-me-64-hex-chars
LOST_FOUND_EMBEDDING_TIMEOUT_SECONDS=8
LOST_FOUND_EMBEDDING_BACKFILL_ENABLED=false
LOST_FOUND_EMBEDDING_BACKFILL_BATCH_SIZE=20
LOST_FOUND_EMBEDDING_DEVICE=cpu
LOST_FOUND_CROSS_MODAL_ENABLED=auto

# ── DeepSeek（设施 planner / 失物 LLM；留空则 L&F 走规则引擎）──
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LOST_FOUND_LLM_API_KEY=
LOST_FOUND_LLM_BASE_URL=https://api.deepseek.com
LOST_FOUND_LLM_MODEL=deepseek-v4-flash
LOST_FOUND_LLM_TIMEOUT_SECONDS=30

# ── MinIO 对象存储 ──
MINIO_ACCESS_KEY=change-me-minio-access-key
MINIO_SECRET_KEY=change-me-minio-secret-key
MINIO_BUCKET=campuslink

# ── CORS（前端域名；同源 nginx 部署可保持 localhost 默认）──
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# ── 前端端口（nginx 容器对外端口；HTTPS 由 certbot 处理后一般保持 80）──
WEB_PORT=80
WEB_HTTPS_PORT=443
# HTTPS 证书域名（nginx 模板用它拼证书路径；certbot 签发也用它）
CERT_DOMAIN=campuslink.local

# ── 镜像仓库（生产 CD：CI 构建推 GHCR，VM 拉取）──
REGISTRY=ghcr.io/your-github-owner
