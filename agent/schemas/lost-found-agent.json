{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campuslink.local/schemas/lost-found-agent-1.8.0.json",
  "agent": "lost-found-agent",
  "version": "1.8.0",
  "description": "校园失物招领领域 Agent。负责报失、登记拾获、双向搜索匹配、查看详情和提交认领；报失、登记拾获和认领必须经过用户确认。",
  "agentType": "domain_agent",
  "transport": {
    "type": "mcp",
    "protocol": "streamable HTTP",
    "baseUrl": "http://localhost:8085",
    "endpoints": {
      "mcp": {
        "method": "POST / GET",
        "path": "/mcp/",
        "description": "MCP streamable HTTP 端点（mcp_servers/lost_found_server.py 适配层，端口 8085；8083 为组员自研 REST /agent/invoke）"
      },
      "health": {"method": "GET", "path": "/health", "authenticated": false}
    }
  },
  "security": {
    "requiredHeaders": ["Authorization", "X-Timestamp"],
    "delegationTokenAudience": "lost-found-agent",
    "tokenAlgorithm": "RS256 (JWKS)",
    "writeConfirmationRequired": ["report_lost", "report_found", "claim_item"],
    "confirmationTtlSeconds": 600
  },
  "capabilities": {
    "domains": ["lost_and_found"],
    "languages": ["zh", "en"],
    "actions": [
      "report_lost",
      "report_found",
      "search_found_items",
      "search_lost_items",
      "get_item_detail",
      "claim_item"
    ],
    "privacy": {
      "exposesPublisherContact": false,
      "exposesStorageObjectKey": false,
      "exposesOtherUsersClaimProof": false
    },
    "rateLimit": {"perUserPerMinute": 5, "perSession": 20}
  },
  "$defs": {
    "category": {
      "type": "string",
      "enum": [
        "ELECTRONICS",
        "CLOTHING",
        "BOOKS_STATIONERY",
        "KEYS",
        "WALLET_PURSE",
        "ID_CARD",
        "BAG",
        "UMBRELLA",
        "OTHER"
      ]
    },
    "invokeInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message": {"type": "string", "minLength": 1, "maxLength": 4000},
        "conversation_context": {
          "type": "object",
          "properties": {
            "previous_agent": {"type": ["string", "null"]},
            "session_id": {"type": ["string", "null"]},
            "shared_data": {"type": "object", "additionalProperties": true}
          },
          "additionalProperties": false
        },
        "confirmed": {"type": "boolean", "default": false},
        "confirmation_id": {"type": ["string", "null"]},
        "trace_parent": {
          "type": "object",
          "properties": {
            "trace_id": {"type": ["string", "null"]},
            "parent_span_id": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        "images": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "object_key": {"type": "string", "minLength": 1, "maxLength": 500},
              "visual_fingerprint": {"type": ["string", "null"]},
              "visual_embedding": {"type": ["string", "null"], "maxLength": 4096},
              "visual_embedding_model": {"type": ["string", "null"]},
              "visual_embedding_revision": {"type": ["string", "null"]},
              "url": {"type": ["string", "null"]}
            },
            "required": ["object_key"]
          }
        }
      },
      "required": ["message"]
    },
    "matchResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item_id": {"type": "string"},
        "report_type": {"type": "string", "enum": ["LOST", "FOUND"]},
        "item_name": {"type": "string"},
        "category": {"$ref": "#/$defs/category"},
        "description": {"type": "string"},
        "colour": {"type": ["string", "null"]},
        "location": {"type": "string"},
        "event_date": {"type": "string", "format": "date"},
        "time_description": {"type": ["string", "null"]},
        "image_urls": {"type": "array", "items": {"type": "string", "format": "uri"}},
        "status": {"type": "string", "enum": ["OPEN", "CLAIMED", "CLOSED"]},
        "match_score": {"type": "number", "minimum": 0, "maximum": 1},
        "match_reason": {"type": "array", "items": {"type": "string"}},
        "score_breakdown": {
          "type": "object",
          "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "matching_mode": {
          "type": "string",
          "enum": ["pretrained_multimodal", "pretrained_image", "pretrained_text", "baseline"]
        }
      },
      "required": [
        "item_id",
        "report_type",
        "item_name",
        "category",
        "description",
        "location",
        "event_date",
        "image_urls",
        "status",
        "match_score",
        "match_reason",
        "score_breakdown",
        "matching_mode"
      ]
    },
    "invokeOutput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "response": {"type": "string"},
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "needs_more_info",
            "match_found",
            "no_match",
            "needs_confirmation",
            "failed"
          ]
        },
        "match_results": {"type": "array", "items": {"$ref": "#/$defs/matchResult"}},
        "confirmation_required": {
          "type": ["object", "null"],
          "properties": {
            "confirmation_id": {"type": "string"},
            "action": {
              "type": "string",
              "enum": ["report_lost", "report_found", "claim_item"]
            },
            "summary": {"type": "string"},
            "expires_at": {"type": "string", "format": "date-time"}
          },
          "required": ["confirmation_id", "action", "summary", "expires_at"]
        },
        "shared_context": {"type": "object", "additionalProperties": true},
        "actions_taken": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "report_lost",
                  "report_found",
                  "search_found_items",
                  "search_lost_items",
                  "get_item_detail",
                  "claim_item"
                ]
              },
              "params_summary": {"type": ["string", "null"]},
              "result_summary": {"type": ["string", "null"]},
              "status": {"type": "string", "enum": ["success", "failed", "skipped"]}
            },
            "required": ["action", "status"]
          }
        },
        "request_id": {"type": "string"}
      },
      "required": ["response", "status", "request_id"]
    },
    "searchInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "report_type": {"type": "string", "enum": ["FOUND", "LOST"]},
        "keyword": {"type": ["string", "null"], "maxLength": 100},
        "category": {"type": ["string", "null"], "maxLength": 50},
        "colour": {"type": ["string", "null"], "maxLength": 50},
        "location": {"type": ["string", "null"], "maxLength": 200},
        "date_from": {"type": ["string", "null"], "format": "date"},
        "date_to": {"type": ["string", "null"], "format": "date"},
        "images": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "object_key": {"type": "string", "minLength": 1, "maxLength": 500},
              "visual_fingerprint": {"type": ["string", "null"]},
              "visual_embedding": {"type": ["string", "null"], "maxLength": 4096},
              "visual_embedding_model": {"type": ["string", "null"]},
              "visual_embedding_revision": {"type": ["string", "null"]},
              "url": {"type": ["string", "null"]}
            },
            "required": ["object_key"]
          }
        }
      },
      "required": ["report_type", "images"]
    },
    "searchOutput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {"type": "string", "enum": ["match_found", "no_match", "failed"]},
        "match_results": {"type": "array", "items": {"$ref": "#/$defs/matchResult"}},
        "request_id": {"type": "string"},
        "message": {"type": ["string", "null"]}
      },
      "required": ["status", "request_id"]
    }
  },
  "invoke": {
    "input": {"$ref": "#/$defs/invokeInput"},
    "output": {"$ref": "#/$defs/invokeOutput"}
  },
  "search": {
    "input": {"$ref": "#/$defs/searchInput"},
    "output": {"$ref": "#/$defs/searchOutput"}
  },
  "internalTools": [
    {
      "name": "report_lost",
      "requiresConfirmation": true,
      "required": ["item_name", "category", "description", "location", "event_date"]
    },
    {
      "name": "report_found",
      "requiresConfirmation": true,
      "required": ["item_name", "category", "description", "location", "event_date"]
    },
    {
      "name": "search_found_items",
      "requiresConfirmation": false,
      "defaults": {"report_type": "FOUND", "status": "OPEN", "limit": 100}
    },
    {
      "name": "search_lost_items",
      "requiresConfirmation": false,
      "defaults": {"report_type": "LOST", "status": "OPEN", "limit": 100}
    },
    {"name": "get_item_detail", "requiresConfirmation": false, "required": ["report_id"]},
    {
      "name": "claim_item",
      "requiresConfirmation": true,
      "required": ["report_id", "proof_description"]
    }
  ],
  "streaming": {
    "status": "not_implemented",
    "deprecated": true,
    "description": "Sprint 3 起不再推送 Agent 内部执行进度（编排层经 MCP 同步调用 invoke）。确认交互由 invoke 返回 status + confirmation_required 承载；以下事件定义保留作历史参考",
    "events": [
      "agent_start",
      "tool_execution",
      "needs_more_info",
      "confirmation_required",
      "model_fallback",
      "token",
      "agent_done",
      "agent_error"
    ],
    "retentionSeconds": 300
  },
  "matching": {
    "candidateDefaults": {
      "lostReportTarget": {"reportType": "FOUND", "status": "OPEN", "limit": 100},
      "foundReportTarget": {"reportType": "LOST", "status": "OPEN", "limit": 100}
    },
    "direction": "bidirectional",
    "topK": 5,
    "defaultMinimumScore": 0.35,
    "weights": {
      "text": 0.25,
      "visual": 0.20,
      "cross_modal": 0.10,
      "category": 0.20,
      "location": 0.10,
      "temporal": 0.10,
      "colour": 0.05
    },
    "visualFingerprint": {
      "queryField": "visual_fingerprint",
      "candidateField": "visualFingerprints",
      "description": "Optional image fingerprint (VF1:...) used for explainable multimodal matching. Active only when both query and candidate carry fingerprints; missing fields are re-normalized away."
    },
    "pretrainedEmbeddings": {
      "textModel": "intfloat/multilingual-e5-small",
      "textRevision": "614241f622f53c4eeff9890bdc4f31cfecc418b3",
      "imageModel": "sentence-transformers/clip-ViT-B-32",
      "imageRevision": "327ab6726d33c0e22f920c83f2ff9e4bd38ca37f",
      "crossModalModel": "sentence-transformers/clip-ViT-B-32-multilingual-v1",
      "crossModalRevision": "58edf8cada9e398793dca955574a48cbb7f18be2",
      "fallback": "hash text embedding + VF1 colour histogram"
    },
    "missingFieldsRenormalizeWeights": true
  },
  "model": {
    "modes": ["auto", "rules", "llm"],
    "compatibleProtocol": "OpenAI chat completions",
    "responsibilities": ["intent_detection", "field_extraction"],
    "allowedTools": [
      "report_lost",
      "report_found",
      "search_found_items",
      "search_lost_items",
      "get_item_detail",
      "claim_item"
    ],
    "maximumToolsPerInvocation": 2,
    "validatedOutput": true,
    "fallbackMode": "rules",
    "writeConfirmationCannotBeBypassed": true
  }
}
