{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent": "facility-agent",
  "version": "1.2.0",
  "description": "CampusLink Facilities MCP tool server for space search, availability, booking lifecycle, and maintenance requests.",
  "type": "mcp_tool_server",
  "transport": {
    "type": "mcp",
    "protocol": "Streamable HTTP",
    "baseUrl": "http://localhost:8080",
    "endpoint": "/mcp",
    "authentication": {
      "type": "bearer",
      "description": "Forward the authenticated CampusLink user's JWT in the Authorization header."
    }
  },
  "capabilities": {
    "domains": [
      "facility_search",
      "room_booking",
      "maintenance_request"
    ],
    "description": "Search campus spaces, check availability, create, track, and cancel user bookings, and submit and track maintenance tickets.",
    "constraints": {
      "max_booking_duration_hours": 4,
      "max_days_in_advance": 14,
      "booking_ownership_enforced": true,
      "booking_cancellation_preserves_audit_record": true,
      "maintenance_ticket_ownership_enforced": true
    }
  },
  "tools": [
    {
      "name": "search_spaces",
      "description": "Search spaces by name or room number, building, type, minimum capacity, equipment, and an optional availability window.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": { "type": "string" },
          "building": { "type": "string" },
          "spaceType": {
            "type": "string",
            "enum": ["STUDY_ROOM", "SEMINAR_ROOM", "SPORTS_VENUE", "LAB", "LECTURE_ROOM", "ANY"]
          },
          "minimumCapacity": { "type": "integer", "minimum": 1 },
          "equipment": {
            "type": "array",
            "items": { "type": "string" }
          },
          "startDateTime": { "type": "string", "description": "ISO local date-time, for example 2026-08-10T14:00:00" },
          "endDateTime": { "type": "string", "description": "ISO local date-time, for example 2026-08-10T16:00:00" }
        }
      }
    },
    {
      "name": "get_space_details",
      "description": "Get full details for one space.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "spaceId": { "type": "integer", "format": "int64" }
        },
        "required": ["spaceId"]
      }
    },
    {
      "name": "check_availability",
      "description": "Check status, opening hours, and booking conflicts for one space and time window.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "spaceId": { "type": "integer", "format": "int64" },
          "startDateTime": { "type": "string", "description": "ISO local date-time" },
          "endDateTime": { "type": "string", "description": "ISO local date-time" }
        },
        "required": ["spaceId", "startDateTime", "endDateTime"]
      }
    },
    {
      "name": "create_booking",
      "description": "Create a confirmed booking for the authenticated user.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "spaceId": { "type": "integer", "format": "int64" },
          "startDateTime": { "type": "string", "description": "ISO local date-time" },
          "endDateTime": { "type": "string", "description": "ISO local date-time" }
        },
        "required": ["spaceId", "startDateTime", "endDateTime"]
      }
    },
    {
      "name": "list_user_bookings",
      "description": "List bookings owned by the authenticated user.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "get_booking_status",
      "description": "Get one booking owned by the authenticated user.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "bookingId": { "type": "integer", "format": "int64" }
        },
        "required": ["bookingId"]
      }
    },
    {
      "name": "cancel_booking",
      "description": "Cancel a future booking owned by the authenticated user while retaining its audit record.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "bookingId": { "type": "integer", "format": "int64" }
        },
        "required": ["bookingId"]
      }
    },
    {
      "name": "submit_maintenance_request",
      "description": "Create a maintenance ticket for the authenticated user using a space ID or explicit building and room.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "spaceId": { "type": "integer", "format": "int64" },
          "building": { "type": "string" },
          "roomNumber": { "type": "string" },
          "facilityType": { "type": "string" },
          "description": { "type": "string", "maxLength": 2000 },
          "priority": {
            "type": "string",
            "enum": ["LOW", "MEDIUM", "HIGH"]
          }
        },
        "required": ["facilityType", "description"]
      }
    },
    {
      "name": "get_maintenance_status",
      "description": "Get one maintenance ticket owned by the authenticated user.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ticketId": { "type": "integer", "format": "int64" }
        },
        "required": ["ticketId"]
      }
    },
    {
      "name": "list_user_maintenance_requests",
      "description": "List maintenance tickets owned by the authenticated user. Use when the user did not provide a ticket ID.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    }
  ],
  "responseConvention": {
    "type": "object",
    "properties": {
      "success": { "type": "boolean" },
      "data": { "type": ["object", "array", "null"] },
      "error": {
        "type": ["object", "null"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    },
    "required": ["success"]
  }
}
