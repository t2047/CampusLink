{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campuslink.local/schemas/facility-agent-1.2.0.json",
  "agent": "facility-agent",
  "version": "1.2.0",
  "description": "校园设施预约 Agent — 搜索可用房间/场馆、查看详情与可用性、创建/查询/取消预订、提交与跟踪报修工单。实现为后端 Spring AI MCP tool server（原生 MCP tools + 用户 JWT bearer 认证）；编排层按 domain_agent 契约调用（需 invoke 适配层，见 transport）。",
  "agentType": "domain_agent",
  "implementation": "spring_ai_mcp_tool_server",
  "transport": {
    "type": "mcp",
    "protocol": "streamable HTTP",
    "baseUrl": "http://localhost:8080",
    "endpoint": "/mcp",
    "authentication": {
      "type": "bearer",
      "description": "Forward the authenticated CampusLink user's JWT in the Authorization header."
    },
    "endpoints": {
      "mcp": {
        "method": "POST / GET",
        "path": "/mcp",
        "description": "Spring AI MCP streamable HTTP（backend 内置，8080）；原生 tools 为 search_spaces 等 10 个。编排层经 invoke 契约调用需在该 MCP server 上提供 invoke 工具（适配层，待接入）"
      },
      "health": {"method": "GET", "path": "/actuator/health", "authenticated": false}
    }
  },
  "security": {
    "requiredHeaders": ["Authorization", "X-Timestamp"],
    "delegationTokenAudience": "facility-agent",
    "tokenAlgorithm": "RS256 (JWKS)",
    "writeConfirmationRequired": ["create_booking", "cancel_booking", "submit_maintenance_request"],
    "confirmationTtlSeconds": 600
  },
  "capabilities": {
    "domains": ["facility_search", "room_booking", "maintenance_request"],
    "languages": ["zh", "en"],
    "actions": [
      "search_spaces",
      "get_space_details",
      "check_availability",
      "create_booking",
      "list_user_bookings",
      "get_booking_status",
      "cancel_booking",
      "submit_maintenance_request",
      "get_maintenance_status",
      "list_user_maintenance_requests"
    ],
    "description": "Search campus spaces, check availability, create, track, and cancel user bookings, and submit and track maintenance tickets.",
    "constraints": {
      "max_booking_duration_hours": 4,
      "max_days_in_advance": 14,
      "booking_ownership_enforced": true,
      "booking_cancellation_preserves_audit_record": true,
      "maintenance_ticket_ownership_enforced": true
    },
    "privacy": {
      "exposesPublisherContact": false,
      "exposesStorageObjectKey": false,
      "exposesOtherUsersClaimProof": false
    },
    "rateLimit": {"perUserPerMinute": 5, "perSession": 20}
  },
  "$defs": {
    "invokeInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message": {"type": "string", "minLength": 1, "maxLength": 4000},
        "conversation_context": {
          "type": "object",
          "properties": {
            "previous_agent": {"type": ["string", "null"]},
            "session_id": {"type": ["string", "null"]},
            "shared_data": {"type": "object", "additionalProperties": true}
          },
          "additionalProperties": false
        },
        "confirmed": {"type": "boolean", "default": false},
        "confirmation_id": {"type": ["string", "null"]},
        "trace_parent": {
          "type": "object",
          "properties": {
            "trace_id": {"type": ["string", "null"]},
            "parent_span_id": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        }
      },
      "required": ["message"]
    },
    "invokeOutput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "response": {"type": "string"},
        "status": {
          "type": "string",
          "enum": ["completed", "needs_more_info", "needs_confirmation", "failed"]
        },
        "confirmation_required": {
          "type": ["object", "null"],
          "properties": {
            "confirmation_id": {"type": "string"},
            "action": {"type": "string"},
            "summary": {"type": "string"},
            "expires_at": {"type": "string", "format": "date-time"}
          },
          "required": ["confirmation_id", "action", "summary", "expires_at"]
        },
        "shared_context": {"type": "object", "additionalProperties": true},
        "actions_taken": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": {"type": "string"},
              "params_summary": {"type": ["string", "null"]},
              "result_summary": {"type": ["string", "null"]},
              "status": {"type": "string", "enum": ["success", "failed", "skipped"]}
            },
            "required": ["action", "status"]
          }
        },
        "request_id": {"type": "string"}
      },
      "required": ["response", "status", "request_id"]
    }
  },
  "invoke": {
    "input": {"$ref": "#/$defs/invokeInput"},
    "output": {"$ref": "#/$defs/invokeOutput"}
  },
  "internalTools": {
    "description": "设施 MCP server 暴露的原生 tools（Spring AI）；编排层经 invoke 适配后按需调用。写操作（create_booking / cancel_booking / submit_maintenance_request）需用户确认。",
    "tools": [
      {"name": "search_spaces", "requiresConfirmation": false},
      {"name": "get_space_details", "requiresConfirmation": false},
      {"name": "check_availability", "requiresConfirmation": false},
      {"name": "create_booking", "requiresConfirmation": true},
      {"name": "list_user_bookings", "requiresConfirmation": false},
      {"name": "get_booking_status", "requiresConfirmation": false},
      {"name": "cancel_booking", "requiresConfirmation": true},
      {"name": "submit_maintenance_request", "requiresConfirmation": true},
      {"name": "get_maintenance_status", "requiresConfirmation": false},
      {"name": "list_user_maintenance_requests", "requiresConfirmation": false}
    ]
  },
  "streaming": {
    "status": "not_implemented",
    "deprecated": true,
    "description": "编排层经 MCP 同步调用 invoke；确认交互由 invoke 返回 status + confirmation_required 承载"
  },
  "model": {
    "modes": ["rules"],
    "responsibilities": ["intent_detection", "action_selection"],
    "fallbackMode": "rules",
    "writeConfirmationCannotBeBypassed": true
  }
}
