{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent": "skill-market-agent",
  "version": "1.0.0",
  "description": "校园技能市场 Agent — 理解用户技能需求（学习/求助/提供服务），自主完成技能搜索、技能详情查看、技能发布、联系技能提供者，并以自然语言返回结果。内部包含 LLM 推理、Tool 选择与执行（ReAct 循环）。",
  "type": "domain_agent",
  "transport": {
    "type": "mcp",
    "protocol": "streamable HTTP",
    "baseUrl": "http://localhost:8084",
    "endpoints": {
      "mcp": {
        "method": "POST / GET",
        "path": "/mcp/",
        "description": "MCP streamable HTTP 端点（Sprint 3 起承载全部调用）。调用工具：invoke（输入/输出契约见下方 invoke 段）"
      },
      "health": {
        "method": "GET",
        "path": "/health",
        "description": "健康检查（无鉴权）"
      }
    }
  },

  "capabilities": {
    "domains": ["skill_market", "peer_learning", "talent_discovery"],
    "description": "可以搜索校园内的技能提供者（编程、语言、音乐、运动、辅导等），查看技能详情和评价，发布自己的技能，向技能达人发送联系请求",
    "examples": [
      "有没有同学可以教我 Python 数据分析",
      "我想找一个会弹吉他的同学",
      "帮我搜一下有没有英语口语陪练",
      "我想发布一个摄影后期技能",
      "帮我联系一下那个教高数辅导的同学",
      "最近有什么新发布的编程相关技能"
    ],
    "constraints": {
      "scope": "校园内注册用户的技能信息",
      "privacy_sensitive": true,
      "contact_requires_consent": true,
      "max_skills_per_user": 10,
      "rate_limit": {
        "max_requests_per_minute": 5,
        "max_requests_per_session": 20
      }
    }
  },

  "invoke": {
    "input": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "description": "用户对技能市场 Agent 的自然语言请求。如搜索技能、发布技能、联系达人等"
        },
        "conversation_context": {
          "type": "object",
          "description": "编排层传递的跨 Agent 上下文",
          "properties": {
            "previous_agent": { "type": "string" },
            "shared_data": {
              "type": "object",
              "description": "跨 Agent 共享数据。如上游 Agent 提取的技能关键词、用户偏好等"
            }
          }
        },
        "confirmed": {
          "type": "boolean",
          "default": false,
          "description": "用户确认发布或联系后重新调用时设为 true"
        },
        "confirmation_id": {
          "type": "string",
          "description": "确认操作对应的 ID"
        },
        "trace_parent": {
          "type": "object",
          "properties": {
            "trace_id": { "type": "string" },
            "parent_span_id": { "type": "string" }
          }
        }
      },
      "required": ["message"]
    },
    "output": {
      "type": "object",
      "properties": {
        "response": {
          "type": "string",
          "description": "Agent 对用户请求的自然语言回复"
        },
        "status": {
          "type": "string",
          "enum": ["completed", "needs_more_info", "no_match", "needs_confirmation", "failed"],
          "description": "completed: 搜索/发布完成; needs_more_info: 需要用户补充信息（如技能详情）; no_match: 未找到匹配; needs_confirmation: 发布或联系需确认; failed: 执行失败"
        },
        "search_results": {
          "type": "array",
          "description": "搜索到的技能列表",
          "items": {
            "type": "object",
            "properties": {
              "skill_id": { "type": "string" },
              "title": { "type": "string" },
              "category": { "type": "string" },
              "level": { "type": "string", "enum": ["beginner", "intermediate", "advanced", "expert"] },
              "description": { "type": "string" },
              "provider_name": { "type": "string" },
              "provider_department": { "type": "string", "description": "提供者院系（脱敏后）" },
              "rating": { "type": "number", "minimum": 0, "maximum": 5 },
              "review_count": { "type": "integer" },
              "availability": { "type": "string" }
            }
          }
        },
        "confirmation_required": {
          "type": "object",
          "description": "操作确认详情。仅 status=needs_confirmation 时有值",
          "properties": {
            "confirmation_id": { "type": "string" },
            "action": {
              "type": "string",
              "enum": ["publish_skill", "contact_provider"],
              "description": "待确认的操作"
            },
            "preview": { "type": "object", "description": "操作预览（如即将发布的技能内容或即将发送的联系消息）" },
            "message": { "type": "string" }
          }
        },
        "shared_context": {
          "type": "object",
          "description": "本 Agent 产出的结构化上下文。如搜索到的技能信息、联系状态等",
          "additionalProperties": true
        },
        "actions_taken": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": { "type": "string", "enum": ["search_skills", "get_skill_detail", "publish_skill", "contact_provider", "list_my_skills"] },
              "params_summary": { "type": "string" },
              "result_summary": { "type": "string" },
              "status": { "type": "string", "enum": ["success", "failed", "skipped"] }
            },
            "required": ["action", "status"]
          }
        }
      },
      "required": ["response", "status"]
    }
  },

  "streaming": {
    "status": "not_implemented",
    "deprecated": true,
    "description": "Sprint 3 起不再推送 Agent 内部执行进度（编排层经 MCP 同步调用 invoke）。确认交互由 invoke 返回 status=needs_confirmation + confirmation_required 承载；前端步骤展示改用返回的 actions_taken。以下事件定义保留作历史参考",
    "events": {
      "agent_start": {
        "payload": {
          "agent": { "type": "string", "const": "skill-market-agent" },
          "message": { "type": "string" }
        }
      },
      "tool_call_start": {
        "payload": {
          "tool": { "type": "string", "enum": ["search_skills", "get_skill_detail", "publish_skill", "contact_provider", "list_my_skills"] },
          "args_summary": { "type": "string" }
        }
      },
      "tool_call_progress": {
        "payload": { "tool": { "type": "string" }, "progress": { "type": "string" } }
      },
      "tool_call_end": {
        "payload": {
          "tool": { "type": "string" },
          "status": { "type": "string", "enum": ["success", "failed"] },
          "result_summary": { "type": "string" }
        }
      },
      "token": {
        "payload": { "content": { "type": "string" } }
      },
      "agent_needs_more_info": {
        "description": "发布技能时需要用户补充更多信息",
        "payload": {
          "field": { "type": "string", "description": "需要补充的字段" },
          "message": { "type": "string" }
        }
      },
      "agent_needs_confirmation": {
        "description": "发布或联系操作需要用户确认",
        "payload": {
          "confirmation_id": { "type": "string" },
          "action": { "type": "string", "enum": ["publish_skill", "contact_provider"] },
          "message": { "type": "string" }
        }
      },
      "agent_done": {
        "payload": {
          "response_summary": { "type": "string" },
          "status": { "type": "string", "enum": ["completed", "no_match", "partial", "failed"] },
          "actions_taken": { "type": "array" }
        }
      },
      "agent_error": {
        "payload": {
          "code": { "type": "string", "enum": ["UNAVAILABLE", "TIMEOUT", "AUTH_FAILED", "INTERNAL_ERROR", "RATE_LIMITED"] },
          "message": { "type": "string" }
        }
      }
    }
  },

  "internalTools": {
    "description": "Agent 内部使用的 Tool 列表。编排层不直接调用，仅供 Agent 内部 ReAct 使用。",
    "tools": [
      {
        "name": "search_skills",
        "description": "搜索校园技能市场中的技能提供者。支持关键词模糊匹配、分类筛选、等级过滤、排序选项。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "keyword": { "type": "string", "description": "技能关键词，如 Python、吉他、日语、高数" },
            "category": {
              "type": "string",
              "enum": ["programming", "language", "music", "art_design", "sports_fitness", "tutoring", "career", "other"]
            },
            "level": {
              "type": "string",
              "enum": ["beginner", "intermediate", "advanced", "expert", "any"],
              "default": "any"
            },
            "sort_by": {
              "type": "string",
              "enum": ["rating", "newest", "relevance"],
              "default": "relevance"
            },
            "max_results": { "type": "integer", "default": 10, "minimum": 1, "maximum": 20 }
          },
          "required": ["keyword"]
        }
      },
      {
        "name": "get_skill_detail",
        "description": "获取单个技能的完整详情，包括提供者简介、评价列表、联系方式（脱敏）。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "skill_id": { "type": "string" }
          },
          "required": ["skill_id"]
        }
      },
      {
        "name": "publish_skill",
        "description": "发布一个新技能供他人搜索和联系。需经 Agent 内部 guard 确认后发布。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": { "type": "string", "description": "技能标题，如「Python 数据分析入门辅导」" },
            "category": {
              "type": "string",
              "enum": ["programming", "language", "music", "art_design", "sports_fitness", "tutoring", "career", "other"]
            },
            "level": {
              "type": "string",
              "enum": ["beginner", "intermediate", "advanced", "expert"]
            },
            "description": { "type": "string", "description": "技能详细描述（擅长的具体内容、教学方式等）" },
            "availability": { "type": "string", "description": "可提供服务的时间说明" },
            "tags": {
              "type": "array",
              "items": { "type": "string" },
              "description": "技能标签，便于搜索"
            }
          },
          "required": ["title", "category", "level", "description"]
        }
      },
      {
        "name": "contact_provider",
        "description": "向技能提供者发送联系请求。需经用户确认。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "skill_id": { "type": "string" },
            "message": { "type": "string", "description": "联系内容（学习目的、时间安排等）" }
          },
          "required": ["skill_id", "message"]
        }
      },
      {
        "name": "list_my_skills",
        "description": "查看当前用户已发布的技能列表及状态。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": ["active", "inactive", "all"],
              "default": "active"
            }
          }
        }
      }
    ]
  }
}
