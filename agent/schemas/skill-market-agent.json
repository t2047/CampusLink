{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent": "skill-market-agent",
  "version": "1.1.0",
  "description": "校园技能市场 Agent — 理解用户技能需求（学习/求助/提供服务），自主完成技能搜索、技能详情查看、技能发布、联系技能提供者，并以自然语言返回结果。内部包含 LLM 推理、Tool 选择与执行（ReAct 循环）。",
  "transport": {
    "type": "mcp",
    "protocol": "streamable HTTP",
    "baseUrl": "http://localhost:8084",
    "endpoints": {
      "mcp": {
        "method": "POST / GET",
        "path": "/mcp/",
        "description": "MCP streamable HTTP 端点（Sprint 3 起承载全部调用）。调用工具：invoke（输入/输出契约见下方 invoke 段）"
      },
      "health": {
        "method": "GET",
        "path": "/health",
        "description": "健康检查（无鉴权）"
      }
    }
  },
  "capabilities": {
    "domains": [
      "skill_market",
      "peer_learning",
      "talent_discovery"
    ],
    "description": "可以搜索校园内的技能提供者（编程、语言、音乐、运动、辅导等），查看技能详情和评价，发布自己的技能，向技能达人发送联系请求",
    "examples": [
      "有没有同学可以教我 Python 数据分析",
      "我想找一个会弹吉他的同学",
      "帮我搜一下有没有英语口语陪练",
      "我想发布一个摄影后期技能",
      "帮我联系一下那个教高数辅导的同学",
      "最近有什么新发布的编程相关技能"
    ],
    "constraints": {
      "scope": "校园内注册用户的技能信息",
      "privacy_sensitive": true,
      "contact_requires_consent": true,
      "max_skills_per_user": 10
    },
    "languages": [
      "zh",
      "en"
    ],
    "actions": [
      "search_skills",
      "get_skill_detail",
      "publish_skill",
      "contact_provider",
      "list_my_skills"
    ],
    "privacy": {
      "exposesPublisherContact": false,
      "exposesStorageObjectKey": false,
      "exposesOtherUsersClaimProof": false
    },
    "rateLimit": {
      "perUserPerMinute": 5,
      "perSession": 20
    }
  },
  "invoke": {
    "input": {
      "$ref": "#/$defs/invokeInput"
    },
    "output": {
      "$ref": "#/$defs/invokeOutput"
    }
  },
  "streaming": {
    "status": "not_implemented",
    "deprecated": true,
    "description": "Sprint 3 起不再推送 Agent 内部执行进度（编排层经 MCP 同步调用 invoke）。确认交互由 invoke 返回 status=needs_confirmation + confirmation_required 承载；前端步骤展示改用返回的 actions_taken。以下事件定义保留作历史参考",
    "events": {
      "agent_start": {
        "payload": {
          "agent": {
            "type": "string",
            "const": "skill-market-agent"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "tool_call_start": {
        "payload": {
          "tool": {
            "type": "string",
            "enum": [
              "search_skills",
              "get_skill_detail",
              "publish_skill",
              "contact_provider",
              "list_my_skills"
            ]
          },
          "args_summary": {
            "type": "string"
          }
        }
      },
      "tool_call_progress": {
        "payload": {
          "tool": {
            "type": "string"
          },
          "progress": {
            "type": "string"
          }
        }
      },
      "tool_call_end": {
        "payload": {
          "tool": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "failed"
            ]
          },
          "result_summary": {
            "type": "string"
          }
        }
      },
      "token": {
        "payload": {
          "content": {
            "type": "string"
          }
        }
      },
      "agent_needs_more_info": {
        "description": "发布技能时需要用户补充更多信息",
        "payload": {
          "field": {
            "type": "string",
            "description": "需要补充的字段"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "agent_needs_confirmation": {
        "description": "发布或联系操作需要用户确认",
        "payload": {
          "confirmation_id": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "publish_skill",
              "contact_provider"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      },
      "agent_done": {
        "payload": {
          "response_summary": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "no_match",
              "partial",
              "failed"
            ]
          },
          "actions_taken": {
            "type": "array"
          }
        }
      },
      "agent_error": {
        "payload": {
          "code": {
            "type": "string",
            "enum": [
              "UNAVAILABLE",
              "TIMEOUT",
              "AUTH_FAILED",
              "INTERNAL_ERROR",
              "RATE_LIMITED"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  },
  "internalTools": {
    "description": "Agent 内部使用的 Tool 列表。编排层不直接调用，仅供 Agent 内部 ReAct 使用。",
    "tools": [
      {
        "name": "search_skills",
        "description": "搜索校园技能市场中的技能提供者。支持关键词模糊匹配、分类筛选、等级过滤、排序选项。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "keyword": {
              "type": "string",
              "description": "技能关键词，如 Python、吉他、日语、高数"
            },
            "category": {
              "type": "string",
              "enum": [
                "programming",
                "language",
                "music",
                "art_design",
                "sports_fitness",
                "tutoring",
                "career",
                "other"
              ]
            },
            "level": {
              "type": "string",
              "enum": [
                "beginner",
                "intermediate",
                "advanced",
                "expert",
                "any"
              ],
              "default": "any"
            },
            "sort_by": {
              "type": "string",
              "enum": [
                "rating",
                "newest",
                "relevance"
              ],
              "default": "relevance"
            },
            "max_results": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 20
            }
          },
          "required": [
            "keyword"
          ]
        },
        "requiresConfirmation": false
      },
      {
        "name": "get_skill_detail",
        "description": "获取单个技能的完整详情，包括提供者简介、评价列表、联系方式（脱敏）。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "skill_id": {
              "type": "string"
            }
          },
          "required": [
            "skill_id"
          ]
        },
        "requiresConfirmation": false
      },
      {
        "name": "publish_skill",
        "description": "发布一个新技能供他人搜索和联系。需经 Agent 内部 guard 确认后发布。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "description": "技能标题，如「Python 数据分析入门辅导」"
            },
            "category": {
              "type": "string",
              "enum": [
                "programming",
                "language",
                "music",
                "art_design",
                "sports_fitness",
                "tutoring",
                "career",
                "other"
              ]
            },
            "level": {
              "type": "string",
              "enum": [
                "beginner",
                "intermediate",
                "advanced",
                "expert"
              ]
            },
            "description": {
              "type": "string",
              "description": "技能详细描述（擅长的具体内容、教学方式等）"
            },
            "availability": {
              "type": "string",
              "description": "可提供服务的时间说明"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "技能标签，便于搜索"
            }
          },
          "required": [
            "title",
            "category",
            "level",
            "description"
          ]
        },
        "requiresConfirmation": true
      },
      {
        "name": "contact_provider",
        "description": "向技能提供者发送联系请求。需经用户确认。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "skill_id": {
              "type": "string"
            },
            "message": {
              "type": "string",
              "description": "联系内容（学习目的、时间安排等）"
            }
          },
          "required": [
            "skill_id",
            "message"
          ]
        },
        "requiresConfirmation": true
      },
      {
        "name": "list_my_skills",
        "description": "查看当前用户已发布的技能列表及状态。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "active",
                "inactive",
                "all"
              ],
              "default": "active"
            }
          }
        },
        "requiresConfirmation": false
      }
    ]
  },
  "$id": "https://campuslink.local/schemas/skill-market-agent-1.1.0.json",
  "agentType": "domain_agent",
  "security": {
    "requiredHeaders": [
      "Authorization",
      "X-Timestamp"
    ],
    "delegationTokenAudience": "skill-market-agent",
    "tokenAlgorithm": "RS256 (JWKS)",
    "writeConfirmationRequired": [
      "publish_skill",
      "contact_provider"
    ],
    "confirmationTtlSeconds": 600
  },
  "$defs": {
    "invokeInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "conversation_context": {
          "type": "object",
          "properties": {
            "previous_agent": {
              "type": [
                "string",
                "null"
              ]
            },
            "session_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "shared_data": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "additionalProperties": false
        },
        "confirmed": {
          "type": "boolean",
          "default": false
        },
        "confirmation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "trace_parent": {
          "type": "object",
          "properties": {
            "trace_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "parent_span_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "message"
      ]
    },
    "invokeOutput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "response": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "needs_more_info",
            "needs_confirmation",
            "failed"
          ]
        },
        "confirmation_required": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "confirmation_id": {
              "type": "string"
            },
            "action": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "confirmation_id",
            "action",
            "summary",
            "expires_at"
          ]
        },
        "shared_context": {
          "type": "object",
          "additionalProperties": true
        },
        "actions_taken": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string"
              },
              "params_summary": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "result_summary": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "success",
                  "failed",
                  "skipped"
                ]
              }
            },
            "required": [
              "action",
              "status"
            ]
          }
        },
        "request_id": {
          "type": "string"
        }
      },
      "required": [
        "response",
        "status",
        "request_id"
      ]
    }
  },
  "model": {
    "modes": [
      "rules"
    ],
    "responsibilities": [
      "intent_detection",
      "action_selection"
    ],
    "fallbackMode": "rules",
    "writeConfirmationCannotBeBypassed": true
  }
}
