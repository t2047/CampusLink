# ========================================
# CampusLink 环境变量配置模板
# ========================================
# 使用说明：
#   1. 复制本文件为 .env ： cp .env.example .env
#   2. 填写你的真实数据库密码
#   3. .env 已在 .gitignore 中，不会被提交到 Git
# ========================================

MYSQL_USER=root
MYSQL_PASSWORD=your_db_password_here
MYSQL_URL=jdbc:mysql://localhost:3306/campusLink_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true

JWT_SECRET=
JWT_EXPIRATON_MS=86400000
