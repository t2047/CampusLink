# ─── CampusLink Environment ────────────────────────────────────────────
# 复制为 .env 并填写真实值。切勿将真实 .env 提交到版本库。

# ─── Web HTTPS ─────────────────────────────────────────────────────────
CERT_DOMAIN=campuslink.tokeninf.xyz
# 仅用于 Let's Encrypt 到期提醒；生产服务器必须填写，勿提交个人真实配置。
CERT_EMAIL=
# 可选：无法读取 EC2 Metadata 时用于签发前核对 DNS，生产服务器建议明确设置。
SERVER_PUBLIC_IP=

# ─── MySQL ─────────────────────────────────────────────────────────────
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_URL=jdbc:mysql://localhost:3306/campusLink_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true

# 兼容别名（部分配置仍引用 DB_*）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campusLink_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# ─── JWT（用户会话，HS256）──────────────────────────────────────────────
# 生成方式：openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# ─── Super Admin（首次启动自动创建）───────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@campuslink.com
SUPER_ADMIN_PASSWORD=Admin123!

# ─── Chat Core 安全 ────────────────────────────────────────────────────
# 编排层共享密钥（HMAC 请求签名，Chat Backend 与编排层共用）
# 本地非 Docker 联调时：仓库根 .env 与 backend/.env 必须配置同一个值。
# ⚠ 生产必须更换为强随机值（openssl rand -hex 32），否则可伪造编排层签名
AGENT_SHARED_SECRET=dev-shared-secret-change-in-production

# Delegation Token（RS256）有效期
DELEGATION_TOKEN_TTL_SECONDS=30

# RSA 密钥持久化目录（首次启动自动生成）
DELEGATION_KEY_DIR=./keys

# ─── 服务地址 ──────────────────────────────────────────────────────────
ORCHESTRATION_BASE_URL=http://127.0.0.1:8000

MAIL_AGENT_URL=http://127.0.0.1:8081
FACILITY_AGENT_URL=http://127.0.0.1:8082
LOSTFOUND_AGENT_URL=http://127.0.0.1:8083
UTILITY_TOOLS_URL=http://127.0.0.1:8090

# Token Service（当前内嵌于 Chat Backend，接口形态与独立 Token Service 一致）
# - 兑换端点：POST /internal/token/exchange
# - Agent 端 RS256 验签公钥：GET /.well-known/jwks.json
# Sprint 3+ 独立部署后仅需切换 TOKEN_SERVICE_URL / TOKEN_SERVICE_JWKS_URL
TOKEN_SERVICE_URL=http://127.0.0.1:8080
TOKEN_SERVICE_JWKS_URL=http://127.0.0.1:8080/.well-known/jwks.json

# Facilities Domain Agent 的 DeepSeek planner（只在 Python facility-agent 环境使用）
# 本地运行时填写仓库根 .env；不要把真实 API key 提交到版本库。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ─── Agent / Utility MCP 端点（Sprint 3）───────────────────────────────
# 注意：Python 服务间互访用 127.0.0.1 而非 localhost —— Windows 上 localhost
# 可能解析为 IPv6 ::1，而 httpx/anyio 只尝试解析出的第一个地址（uvicorn 常只绑 IPv4），
# 导致“All connection attempts failed”但 curl 却正常。
# 部署到其它地址时覆盖：
# MAIL_AGENT_MCP_URL=http://127.0.0.1:8081/mcp/
# FACILITY_AGENT_MCP_URL=http://127.0.0.1:8082/mcp/
# LOSTFOUND_AGENT_MCP_URL=http://127.0.0.1:8085/mcp/   # L&F MCP 适配层（8083 为组员 REST）
# UTILITY_TOOLS_MCP_URL=http://127.0.0.1:8090/mcp/

# ─── 失物招领（Lost & Found）───────────────────────────────────────────
# 图片存储（MinIO）
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=campuslink
MINIO_PRESIGNED_URL_MINUTES=15

# Comma-separated React origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Lost & Found Agent REST 入口（供 Spring Boot 的 Web 测试代理直连；
# 上方 LOSTFOUND_AGENT_URL 供 Chat Core 服务注册使用）
# 生产环境请分别生成独立的 32+ 字符随机值；
# 下方占位值仅供本地联调，字段有 min_length=32 校验，空值会导致容器启动失败）
LOST_FOUND_AGENT_URL=http://localhost:8083
AGENT_BACKEND_SHARED_SECRET=dev-agent-backend-shared-secret-0123456789abcdef
LOST_FOUND_CONFIRMATION_SECRET=dev-lf-confirmation-secret-0123456789abcdef
LOST_FOUND_AGENT_MODE=auto
LOST_FOUND_LLM_API_KEY=
LOST_FOUND_LLM_BASE_URL=https://api.deepseek.com
LOST_FOUND_LLM_MODEL=deepseek-v4-flash
LOST_FOUND_LLM_TIMEOUT_SECONDS=15
# 默认降级到同样受确认流程和工具白名单约束的规则引擎；安全审计场景可设 true。
LOST_FOUND_LLM_FAIL_CLOSED=false

# ── L&F 调优项（均可省略，用默认值）────────────────────────────────
# 网关直连后端地址（Agent 内 CampusApiClient 用；默认 http://localhost:8080）
CAMPUS_API_URL=http://localhost:8080
LOST_FOUND_AGENT_HOST=0.0.0.0
LOST_FOUND_AGENT_PORT=8083
AGENT_SECURITY_TIME_WINDOW_SECONDS=30
AGENT_NONCE_TTL_SECONDS=60
AGENT_EVENT_TTL_SECONDS=300
AGENT_RATE_LIMIT_PER_MINUTE=5
AGENT_RATE_LIMIT_PER_SESSION=20
LOST_FOUND_MATCH_MIN_SCORE=0.35

# 预训练多模态匹配；只有启用 Docker multimodal profile 才会加载模型
LOST_FOUND_EMBEDDING_MODE=auto
LOST_FOUND_EMBEDDING_URL=http://localhost:8091
LOST_FOUND_EMBEDDING_SHARED_SECRET=replace-with-at-least-16-characters
# 政策/规章制度 RAG（search_policy）复用同一 embedding 服务的上述密钥；
# Qdrant 地址在 docker-compose 内固定为 http://qdrant:6333（本地可设
# POLICY_RAG_QDRANT_URL / POLICY_RAG_QDRANT_LOCAL_PATH 覆盖，见 docs/policy_rag.md）
LOST_FOUND_EMBEDDING_TIMEOUT_SECONDS=8
LOST_FOUND_EMBEDDING_BACKFILL_ENABLED=false
LOST_FOUND_EMBEDDING_BACKFILL_BATCH_SIZE=20
LOST_FOUND_EMBEDDING_DEVICE=cpu
LOST_FOUND_CROSS_MODAL_ENABLED=auto
LOST_FOUND_EMBEDDING_TEXT_MODEL=intfloat/multilingual-e5-small
LOST_FOUND_EMBEDDING_TEXT_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
LOST_FOUND_EMBEDDING_IMAGE_MODEL=sentence-transformers/clip-ViT-B-32
LOST_FOUND_EMBEDDING_IMAGE_REVISION=327ab6726d33c0e22f920c83f2ff9e4bd38ca37f
LOST_FOUND_EMBEDDING_CROSS_MODAL_MODEL=sentence-transformers/clip-ViT-B-32-multilingual-v1
LOST_FOUND_EMBEDDING_CROSS_MODAL_REVISION=58edf8cada9e398793dca955574a48cbb7f18be2
LOST_FOUND_TEXT_CALIBRATION_MIN=0.65
LOST_FOUND_TEXT_CALIBRATION_MAX=0.95
LOST_FOUND_IMAGE_CALIBRATION_MIN=0.50
LOST_FOUND_IMAGE_CALIBRATION_MAX=0.95
LOST_FOUND_CROSS_MODAL_CALIBRATION_MIN=0.15
LOST_FOUND_CROSS_MODAL_CALIBRATION_MAX=0.40


# ---- Gmail OAuth (mail service) ----
# 留空则回退到代码内项目默认客户端（agent/mail_agent/mail_agent/config.py）。
# 注意：不可写 "GMAIL_CLIENT_ID=" 这种显式空值再指望默认值——config.py 已把空值
# 视为未设置回退默认；若此处填了值则必须与 Google Cloud Console 中的客户端一致。
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# 本地开发：固定 localhost 回调（须与 Console 注册一致）。
# 生产部署留空：服务按请求的 Host / X-Forwarded-Proto 自动推导
# https://<CERT_DOMAIN>/callback。
GMAIL_REDIRECT_URI=http://localhost:5000/callback
MAIL_FRONTEND_URL=http://localhost:5173
MAIL_REST_URL=http://127.0.0.1:5000

# ---- Mail 身份（按用户绑定 Gmail）----
# mail 服务验证 CampusLink 用户 JWT（HS256），密钥必须与后端 JWT_SECRET 一致
#（后端 application.properties: app.jwt.secret=${JWT_SECRET:...}，上面已定义）。
# 内部令牌密钥：mail MCP 网关（聊天路径）用它代签短时令牌调用 mail REST；
# 留空回退 AGENT_SHARED_SECRET。生产建议显式设置独立强随机值。
MAIL_INTERNAL_SECRET=
# 每个用户的 Gmail OAuth token 存储目录（默认 agent/mail_agent/gmail_tokens；
# Docker 内固定为 /data/gmail_tokens，见 docker-compose.yml）。
# GMAIL_TOKEN_DIR=

# ---- Mail Agent LLM (LangChain) ----
# 留空时回退到 DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / DEEPSEEK_MODEL。
MAIL_LLM_API_KEY=
MAIL_LLM_BASE_URL=https://api.deepseek.com
MAIL_LLM_MODEL=deepseek-v4-flash
MAIL_AGENT_MAX_TOKENS=2000
